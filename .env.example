# =============================================================================
# Parry Burger Express — variables de entorno
# Copiá este archivo a .env y completá los valores.
# Documentación completa: README.md
# =============================================================================

# --- Base de datos (Neon PostgreSQL) — OBLIGATORIO ---
# DATABASE_URL: usar connection string con pooler (para la app)
# DIRECT_URL:   usar connection string directo (para migraciones Prisma)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/parry?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/parry?sslmode=require

# --- Autenticación admin — OBLIGATORIO ---
# Generar: openssl rand -base64 32
# En producción usar un valor distinto al de desarrollo.
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- Vercel Blob — OBLIGATORIO para subir imágenes en admin ---
# Crear en Vercel Dashboard → Storage → Blob
# Sin este token: productos/promos/config funcionan pero upload falla (503).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# =============================================================================
# Comandos iniciales:
#   npm install
#   npm run db:migrate     # desarrollo (crea tablas)
#   npm run db:seed        # datos iniciales
#   npm run dev
#
# Producción (Vercel):
#   Build: prisma generate && prisma migrate deploy && next build
#   Post-deploy: npm run db:seed (una vez)
#   Cambiar password: npm run admin:hash-password -- admin@parryburger.com NuevaPass
#
# Admin seed:
#   Email:    admin@parryburger.com
#   Password: admin123456
# =============================================================================
