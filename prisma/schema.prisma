generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum OrderStatus {
  NUEVO
  PREPARANDO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum DeliveryType {
  RETIRO
  DELIVERY
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BusinessSettings {
  id                 String   @id @default("default")
  businessName       String
  slogan             String?
  whatsappNumber     String
  instagramUrl       String?
  facebookUrl        String?
  address            String?
  mapsUrl            String?
  mapsEmbedUrl       String?  @db.Text
  deliveryCost       Decimal  @db.Decimal(10, 2)
  heroTag            String?
  heroTitleLine1     String?
  heroTitleLine2     String?
  heroTitleLine3     String?
  heroDescription    String?  @db.Text
  heroImageUrl       String?
  heroImagePosition  String   @default("center")
  footerText         String?  @db.Text
  openingHoursJson   Json
  paymentMethodsJson Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?        @db.Text
  price       Decimal        @db.Decimal(10, 2)
  imageUrl       String?
  imagePosition  String         @default("center")
  active         Boolean        @default(true)
  featured       Boolean        @default(false)
  sortOrder      Int            @default(0)
  categoryId     String
  category    Category       @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  promoLinks  PromoProduct[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId, active, sortOrder])
}

model Promo {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?        @db.Text
  price       Decimal        @db.Decimal(10, 2)
  imageUrl       String?
  imagePosition  String         @default("center")
  active         Boolean        @default(true)
  featured       Boolean        @default(true)
  sortOrder      Int            @default(0)
  products       PromoProduct[]
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([active, sortOrder])
}

model PromoProduct {
  promoId   String
  productId String
  promo     Promo   @relation(fields: [promoId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoId, productId])
}

model Order {
  id              String        @id @default(cuid())
  orderCode       String        @unique
  customerName    String
  customerPhone   String
  deliveryType    DeliveryType
  address         String?
  zone            String?
  paymentMethod   String
  notes           String?       @db.Text
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryCost    Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  status          OrderStatus   @default(NUEVO)
  whatsappMessage String?       @db.Text
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  promoId   String?
  promo     Promo?   @relation(fields: [promoId], references: [id], onDelete: SetNull)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  subtotal  Decimal  @db.Decimal(10, 2)
}

model ImageAsset {
  id        String   @id @default(cuid())
  url       String
  pathname  String?
  filename  String?
  folder    String?
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
}
